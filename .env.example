# Next.js app. Copy to .env.local (gitignored).
# `npx convex dev` writes the CONVEX_* and NEXT_PUBLIC_CONVEX_* lines itself.

# Convex
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk: Dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# ---------------------------------------------------------------------------
# These are NOT read from this file. They live on the Convex deployment, set
# with `npx convex env set NAME value`:
#
#   CLERK_JWT_ISSUER_DOMAIN  Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
#   LENDLOOP_HMAC_SECRET     same value as in n8n/.env (openssl rand -hex 32)
#   N8N_NOTIFY_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-notify
#
# n8n's settings are in n8n/.env (see n8n/.env.example).
