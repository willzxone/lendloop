# Copy to n8n/.env (gitignored) and fill in. Read by docker-compose.yml.

# Encrypts credentials inside n8n's database. Generate once and keep it:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-me

# Shared HMAC secret. Must be the same value as LENDLOOP_HMAC_SECRET on the
# Convex deployment (npx convex env set LENDLOOP_HMAC_SECRET ...). At least
# 32 characters:
#   openssl rand -hex 32
LENDLOOP_HMAC_SECRET=replace-me

# Convex HTTP actions as seen from inside the container. For a local Convex
# deployment this is port 3211 on the host; for Convex cloud use the
# https://<deployment>.convex.site URL.
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Sender shown on notification and reminder emails.
LENDLOOP_MAIL_FROM=LendLoop <no-reply@lendloop.local>

# Used for links inside the emails.
LENDLOOP_APP_URL=http://localhost:3000
